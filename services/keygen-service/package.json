{
  "name": "@rosen-bridge/keygen-service",
  "private": true,
  "version": "1.0.3",
  "description": "A service for managing the key generation ceremony",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/sign-protocols.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "prettify:check": "prettier --check . --ignore-path ./.gitignore",
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx watch ./src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^5.4.1",
    "@chainsafe/libp2p-noise": "^10.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.8.0",
    "@fastify/swagger-ui": "^1.9.3",
    "@fastify/type-provider-typebox": "^3.4.0",
    "@libp2p/bootstrap": "^5.0.2",
    "@libp2p/interface-connection": "^3.0.6",
    "@libp2p/interface-peer-id": "^1.1.2",
    "@libp2p/mplex": "^7.1.1",
    "@libp2p/peer-id-factory": "^1.0.18",
    "@libp2p/pubsub-peer-discovery": "^7.0.1",
    "@libp2p/websockets": "^5.0.2",
    "@multiformats/multiaddr": "^11.0.3",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-bridge/winston-logger": "^3.1.0",
    "@rosen-clients/rate-limited-axios": "^2.0.1",
    "@sinclair/typebox": "^0.30.4",
    "config": "^3.3.7",
    "fastify": "^4.18.0",
    "it-length-prefixed": "8.0.4",
    "it-map": "2.0.0",
    "it-pipe": "2.0.4",
    "it-pushable": "^3.1.0",
    "libp2p": "^0.41.0",
    "lodash-es": "^4.17.21",
    "uint8arrays": "^3.1.0"
  },
  "devDependencies": {
    "@types/config": "^0.0.41",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^22.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
