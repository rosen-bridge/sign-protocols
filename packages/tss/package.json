{
  "name": "@rosen-bridge/tss",
  "version": "6.0.0",
  "description": "TypeScript library for building and validating TSS signatures.",
  "keywords": [
    "rosen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/sign-protocols.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage --run",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ./../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ./../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/communication": "^3.0.0",
    "@rosen-bridge/detection": "^3.0.0",
    "@rosen-bridge/encryption": "^1.0.1",
    "@rosen-bridge/semaphore": "^0.1.0",
    "@rosen-clients/rate-limited-axios": "^2.0.1",
    "secp256k1": "^5.0.1"
  },
  "devDependencies": {
    "@types/secp256k1": "^4.0.7"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
