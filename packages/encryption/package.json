{
  "name": "@rosen-bridge/encryption",
  "version": "1.0.1",
  "description": "unify encryption interface",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/sign-protocols.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ./../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ./../../.gitignore",
    "release": "npm run clean && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1",
    "secp256k1": "^5.0.1"
  },
  "devDependencies": {
    "@types/secp256k1": "^4.0.7"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
